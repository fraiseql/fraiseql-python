# Database Configuration
DATABASE_URL=postgresql://localhost:5432/ragdb

# OpenAI Configuration (for embeddings and chat)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: the embedding model name recorded with each embedding
# EMBEDDING_MODEL=text-embedding-ada-002

# Optional: local models (sentence-transformers embeddings, vLLM answers).
# Set schema.sql's vector(1536) to your embedding model's size.
# USE_LOCAL_EMBEDDINGS=false
# LOCAL_MODEL_URL=http://localhost:8000/v1
# LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DEVICE=cuda

# Optional: the chat model (default gpt-4o-mini, or local-model with local models)
# LLM_MODEL=gpt-4o-mini
