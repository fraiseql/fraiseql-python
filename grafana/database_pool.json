{
  "dashboard": {
    "uid": "fraiseql-database",
    "title": "FraiseQL Database Pool",
    "description": "Connections and query statistics read from PostgreSQL itself (pg_stat_activity, pg_stat_database, pg_stat_user_tables, v_query_stats). The current values: PostgreSQL keeps no history of them.",
    "tags": [
      "fraiseql",
      "database",
      "pool",
      "connections"
    ],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "templating": {
      "list": [
        {
          "name": "datasource",
          "label": "PostgreSQL",
          "type": "datasource",
          "query": "grafana-postgresql-datasource",
          "current": {},
          "hide": 0,
          "refresh": 1,
          "regex": "",
          "options": []
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Active Connections",
        "type": "stat",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "rawQuery": true,
            "rawSql": "SELECT COUNT(*) AS active_connections\nFROM pg_stat_activity\nWHERE datname = current_database()\n  AND backend_type = 'client backend'\n  AND state = 'active'\n  AND pid <> pg_backend_pid()",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          }
        }
      },
      {
        "id": 2,
        "title": "Idle Connections",
        "type": "stat",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 6,
          "y": 0
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "rawQuery": true,
            "rawSql": "SELECT COUNT(*) AS idle_connections\nFROM pg_stat_activity\nWHERE datname = current_database()\n  AND backend_type = 'client backend'\n  AND state = 'idle'",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          }
        }
      },
      {
        "id": 3,
        "title": "Idle in Transaction",
        "type": "stat",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "rawQuery": true,
            "rawSql": "SELECT COUNT(*) AS idle_in_transaction\nFROM pg_stat_activity\nWHERE datname = current_database()\n  AND backend_type = 'client backend'\n  AND state LIKE 'idle in transaction%'",
            "format": "table"
          }
        ],
        "description": "Connections holding a transaction open without running a query: a pool connection not returned, or a leak.",
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 1
                }
              ]
            },
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          }
        }
      },
      {
        "id": 4,
        "title": "Total Connections",
        "type": "stat",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 18,
          "y": 0
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "rawQuery": true,
            "rawSql": "SELECT COUNT(*) AS total_connections\nFROM pg_stat_activity\nWHERE datname = current_database()\n  AND backend_type = 'client backend'",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          }
        }
      },
      {
        "id": 5,
        "title": "Connection Utilization",
        "type": "gauge",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 0,
          "y": 4
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "rawQuery": true,
            "rawSql": "WITH conns AS (\n  SELECT COUNT(*) AS used\n  FROM pg_stat_activity\n  WHERE backend_type = 'client backend'\n)\nSELECT ROUND(100.0 * used / current_setting('max_connections')::int, 1) AS utilization_percent\nFROM conns",
            "format": "table"
          }
        ],
        "description": "Client connections to the server (every database) as a share of max_connections.",
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 70
                },
                {
                  "color": "red",
                  "value": 90
                }
              ]
            },
            "unit": "percent"
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          }
        }
      },
      {
        "id": 6,
        "title": "Connections by Application",
        "type": "table",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 16,
          "x": 8,
          "y": 4
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "rawQuery": true,
            "rawSql": "SELECT\n  COALESCE(NULLIF(application_name, ''), '(not set)') AS application_name,\n  usename,\n  state,\n  COUNT(*) AS connections\nFROM pg_stat_activity\nWHERE datname = current_database()\n  AND backend_type = 'client backend'\nGROUP BY application_name, usename, state\nORDER BY connections DESC\nLIMIT 50",
            "format": "table"
          }
        ],
        "description": "The app's psycopg pool shows up under the application_name of its connection string.",
        "fieldConfig": {
          "defaults": {},
          "overrides": []
        },
        "options": {
          "showHeader": true
        }
      },
      {
        "id": 7,
        "title": "Longest Running Queries",
        "type": "table",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 12
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "rawQuery": true,
            "rawSql": "SELECT\n  pid,\n  COALESCE(NULLIF(application_name, ''), '(not set)') AS application_name,\n  state,\n  wait_event_type,\n  NOW() - query_start AS running_for,\n  LEFT(query, 120) AS query\nFROM pg_stat_activity\nWHERE datname = current_database()\n  AND backend_type = 'client backend'\n  AND state <> 'idle'\n  AND pid <> pg_backend_pid()\nORDER BY query_start\nLIMIT 20",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {},
          "overrides": []
        },
        "options": {
          "showHeader": true
        }
      },
      {
        "id": 8,
        "title": "Top Queries by Total Time",
        "type": "table",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 10,
          "w": 24,
          "x": 0,
          "y": 20
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "rawQuery": true,
            "rawSql": "SELECT\n  query_preview,\n  calls,\n  total_exec_time_ms,\n  mean_exec_time_ms,\n  max_exec_time_ms,\n  rows_returned,\n  cache_hit_ratio\nFROM v_query_stats\nORDER BY total_exec_time_ms DESC\nLIMIT 20",
            "format": "table"
          }
        ],
        "description": "Needs pg_stat_statements (shared_preload_libraries + CREATE EXTENSION) installed before schema.sql is loaded, which creates v_query_stats. Counters are cumulative since the last pg_stat_statements_reset().",
        "fieldConfig": {
          "defaults": {},
          "overrides": []
        },
        "options": {
          "showHeader": true
        }
      },
      {
        "id": 9,
        "title": "Slowest Queries by Mean Time",
        "type": "table",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 10,
          "w": 24,
          "x": 0,
          "y": 30
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "rawQuery": true,
            "rawSql": "SELECT\n  query_preview,\n  calls,\n  mean_exec_time_ms,\n  min_exec_time_ms,\n  max_exec_time_ms,\n  total_exec_time_ms\nFROM v_query_stats\nWHERE calls >= 10\nORDER BY mean_exec_time_ms DESC\nLIMIT 20",
            "format": "table"
          }
        ],
        "description": "Statements called at least 10 times, from v_query_stats (pg_stat_statements).",
        "fieldConfig": {
          "defaults": {},
          "overrides": []
        },
        "options": {
          "showHeader": true
        }
      },
      {
        "id": 10,
        "title": "Buffer Cache Hit Ratio",
        "type": "stat",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 0,
          "y": 40
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "rawQuery": true,
            "rawSql": "SELECT ROUND(100.0 * blks_hit / NULLIF(blks_hit + blks_read, 0), 2) AS cache_hit_percent\nFROM pg_stat_database\nWHERE datname = current_database()",
            "format": "table"
          }
        ],
        "description": "Share of block reads served from shared buffers since the statistics were last reset.",
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          }
        }
      },
      {
        "id": 11,
        "title": "Top Tables by Scans",
        "type": "table",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 18,
          "x": 6,
          "y": 40
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "rawQuery": true,
            "rawSql": "SELECT\n  schemaname,\n  relname AS table_name,\n  seq_scan,\n  idx_scan,\n  n_tup_ins AS rows_inserted,\n  n_tup_upd AS rows_updated,\n  n_tup_del AS rows_deleted,\n  n_live_tup AS live_rows\nFROM pg_stat_user_tables\nORDER BY seq_scan + COALESCE(idx_scan, 0) DESC\nLIMIT 20",
            "format": "table"
          }
        ],
        "description": "Cumulative counters from pg_stat_user_tables since the statistics were last reset.",
        "fieldConfig": {
          "defaults": {},
          "overrides": []
        },
        "options": {
          "showHeader": true
        }
      }
    ]
  },
  "overwrite": true,
  "message": "FraiseQL Database Pool Dashboard"
}
