{
  "dashboard": {
    "uid": "fraiseql-apq",
    "title": "FraiseQL APQ Storage",
    "description": "Persisted queries stored by the PostgreSQL APQ backend (apq_storage_backend=\"postgresql\", default table_prefix \"apq_\").",
    "tags": [
      "fraiseql",
      "apq",
      "persisted-queries",
      "performance"
    ],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "5m",
    "time": {
      "from": "now-7d",
      "to": "now"
    },
    "templating": {
      "list": [
        {
          "name": "datasource",
          "label": "PostgreSQL",
          "type": "datasource",
          "query": "grafana-postgresql-datasource",
          "current": {},
          "hide": 0,
          "refresh": 1,
          "regex": "",
          "options": []
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Stored Persisted Queries",
        "type": "stat",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "rawQuery": true,
            "rawSql": "SELECT COUNT(*) AS stored_queries FROM apq_queries",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          }
        }
      },
      {
        "id": 2,
        "title": "New Persisted Queries",
        "type": "stat",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 6,
          "y": 0
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "rawQuery": true,
            "rawSql": "SELECT COUNT(*) AS new_queries\nFROM apq_queries\nWHERE $__timeFilter(created_at)",
            "format": "table"
          }
        ],
        "description": "Queries registered for the first time in the time range.",
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          }
        }
      },
      {
        "id": 3,
        "title": "Cached Responses",
        "type": "stat",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "rawQuery": true,
            "rawSql": "SELECT COUNT(*) AS cached_responses FROM apq_responses",
            "format": "table"
          }
        ],
        "description": "Rows of apq_responses: filled only when APQ response caching is on.",
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          }
        }
      },
      {
        "id": 4,
        "title": "APQ Storage Size",
        "type": "stat",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 18,
          "y": 0
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "rawQuery": true,
            "rawSql": "SELECT SUM(pg_total_relation_size(oid)) AS storage_bytes\nFROM pg_class\nWHERE oid IN ('apq_queries'::regclass, 'apq_responses'::regclass)",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes"
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          }
        }
      },
      {
        "id": 5,
        "title": "APQ Storage Growth",
        "type": "timeseries",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 6
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "rawQuery": true,
            "rawSql": "SELECT\n  $__timeGroupAlias(created_at, $__interval),\n  COUNT(*) AS new_queries\nFROM apq_queries\nWHERE $__timeFilter(created_at)\nGROUP BY 1\nORDER BY 1",
            "format": "time_series"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "lineInterpolation": "smooth",
              "showPoints": "never",
              "fillOpacity": 10
            },
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        }
      },
      {
        "id": 6,
        "title": "Cached Responses by Tenant",
        "type": "bargauge",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 6
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "rawQuery": true,
            "rawSql": "SELECT\n  COALESCE(tenant_id, '(no tenant)') AS tenant_id,\n  COUNT(*) AS cached_responses\nFROM apq_responses\nGROUP BY tenant_id\nORDER BY cached_responses DESC\nLIMIT 20",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": true
          },
          "orientation": "horizontal",
          "displayMode": "gradient"
        }
      },
      {
        "id": 7,
        "title": "Recently Registered Queries",
        "type": "table",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 14
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "rawQuery": true,
            "rawSql": "SELECT\n  hash,\n  LEFT(query, 100) AS query_preview,\n  created_at,\n  updated_at\nFROM apq_queries\nWHERE $__timeFilter(created_at)\nORDER BY created_at DESC\nLIMIT 20",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {},
          "overrides": []
        },
        "options": {
          "showHeader": true
        }
      },
      {
        "id": 8,
        "title": "Largest Persisted Queries",
        "type": "table",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 14
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "rawQuery": true,
            "rawSql": "SELECT\n  hash,\n  OCTET_LENGTH(query) AS query_bytes,\n  LEFT(query, 100) AS query_preview,\n  created_at\nFROM apq_queries\nORDER BY query_bytes DESC\nLIMIT 20",
            "format": "table"
          }
        ],
        "description": "The bytes a client saves on each request that sends only the hash of this query.",
        "fieldConfig": {
          "defaults": {},
          "overrides": []
        },
        "options": {
          "showHeader": true
        }
      }
    ]
  },
  "overwrite": true,
  "message": "FraiseQL APQ Storage Dashboard"
}
