{
  "dashboard": {
    "uid": "fraiseql-performance",
    "title": "FraiseQL Performance Metrics",
    "description": "HTTP metrics recorded by MetricsMiddleware: call setup_metrics(app) and scrape GET /metrics.",
    "tags": [
      "fraiseql",
      "performance",
      "http",
      "prometheus"
    ],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "templating": {
      "list": [
        {
          "name": "datasource",
          "label": "Prometheus",
          "type": "datasource",
          "query": "prometheus",
          "current": {},
          "hide": 0,
          "refresh": 1,
          "regex": "",
          "options": []
        },
        {
          "name": "job",
          "label": "Job",
          "type": "query",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "definition": "label_values(fraiseql_http_requests_total, job)",
          "query": {
            "query": "label_values(fraiseql_http_requests_total, job)",
            "refId": "PrometheusVariableQueryEditor-VariableQuery"
          },
          "includeAll": true,
          "allValue": ".*",
          "multi": true,
          "refresh": 2,
          "current": {
            "text": "All",
            "value": "$__all"
          },
          "options": []
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Request Rate (req/sec)",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "expr": "sum by (endpoint) (rate(fraiseql_http_requests_total{job=~\"$job\"}[$__rate_interval]))",
            "legendFormat": "{{endpoint}}",
            "range": true,
            "instant": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {
              "lineInterpolation": "smooth",
              "showPoints": "never",
              "fillOpacity": 10
            },
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        }
      },
      {
        "id": 2,
        "title": "Response Time Percentiles",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "refId": "P50",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "expr": "histogram_quantile(0.50, sum by (le) (rate(fraiseql_http_request_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
            "legendFormat": "P50",
            "range": true,
            "instant": false
          },
          {
            "refId": "P95",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "expr": "histogram_quantile(0.95, sum by (le) (rate(fraiseql_http_request_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
            "legendFormat": "P95",
            "range": true,
            "instant": false
          },
          {
            "refId": "P99",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "expr": "histogram_quantile(0.99, sum by (le) (rate(fraiseql_http_request_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
            "legendFormat": "P99",
            "range": true,
            "instant": false
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {
              "lineInterpolation": "smooth",
              "showPoints": "never",
              "fillOpacity": 10
            },
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        }
      },
      {
        "id": 3,
        "title": "Slowest Endpoints (P99)",
        "type": "table",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "expr": "topk(20, histogram_quantile(0.99, sum by (le, method, endpoint) (rate(fraiseql_http_request_duration_seconds_bucket{job=~\"$job\"}[$__range]))))",
            "legendFormat": "__auto",
            "range": false,
            "instant": true,
            "format": "table"
          }
        ],
        "description": "P99 latency over the time range, per method and path. All GraphQL operations share the /graphql endpoint.",
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          },
          "overrides": []
        },
        "options": {
          "showHeader": true
        }
      },
      {
        "id": 4,
        "title": "Responses by Status",
        "type": "piechart",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "expr": "sum by (status) (increase(fraiseql_http_requests_total{job=~\"$job\"}[$__range]))",
            "legendFormat": "{{status}}",
            "range": false,
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {},
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "right"
          },
          "pieType": "pie",
          "displayLabels": [
            "name",
            "percent"
          ],
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          }
        }
      },
      {
        "id": 5,
        "title": "Requests by Endpoint",
        "type": "bargauge",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "expr": "topk(10, sum by (endpoint) (increase(fraiseql_http_requests_total{job=~\"$job\"}[$__range])))",
            "legendFormat": "{{endpoint}}",
            "range": false,
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "orientation": "horizontal",
          "displayMode": "gradient"
        }
      },
      {
        "id": 6,
        "title": "5xx Rate by Endpoint",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 16
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "expr": "100 * sum by (endpoint) (rate(fraiseql_http_requests_total{job=~\"$job\", status=~\"5..\"}[$__rate_interval])) / sum by (endpoint) (rate(fraiseql_http_requests_total{job=~\"$job\"}[$__rate_interval]))",
            "legendFormat": "{{endpoint}}",
            "range": true,
            "instant": false
          }
        ],
        "description": "A GraphQL error in a 200 response is not counted here: see the Error Monitoring dashboard.",
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "custom": {
              "lineInterpolation": "smooth",
              "showPoints": "never",
              "fillOpacity": 10
            },
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        }
      },
      {
        "id": 7,
        "title": "Unhandled Exceptions by Type",
        "type": "timeseries",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 24
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "expr": "sum by (error_type) (rate(fraiseql_errors_total{job=~\"$job\"}[$__rate_interval]))",
            "legendFormat": "{{error_type}}",
            "range": true,
            "instant": false
          }
        ],
        "description": "Exceptions that escaped the app (error_code=HTTP_ERROR) or a @with_metrics function.",
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "lineInterpolation": "smooth",
              "showPoints": "never",
              "fillOpacity": 10
            },
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        }
      },
      {
        "id": 8,
        "title": "Average Response Time",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 24
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "expr": "sum(rate(fraiseql_response_time_seconds_sum{job=~\"$job\"}[$__range])) / sum(rate(fraiseql_response_time_seconds_count{job=~\"$job\"}[$__range]))",
            "legendFormat": "average",
            "range": false,
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          }
        }
      }
    ]
  },
  "overwrite": true,
  "message": "FraiseQL Performance Metrics Dashboard"
}
